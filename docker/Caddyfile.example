# Utopinn 前置 TLS 样例。用法:cp docker/Caddyfile.example docker/Caddyfile,
# compose 里 caddy 服务取消注释,.env 写 DOMAIN=your.domain。
#
# {$DOMAIN} 由 caddy 容器环境变量 DOMAIN 注入;反代目标是 compose 服务名 app。
#
# IP 白名单(可选):应用层 whitelistMode 在反代下只认 XFF/边缘 ACL,推荐在边缘做:
#   @blocked not remote_ip 203.0.113.7 10.0.0.0/8
#   respond @blocked 403
# 放开后下面 respond 行前取消注释即可;whitelistMode 细节见 README「反代 × whitelistMode」。

{$DOMAIN} {
	# @blocked not remote_ip 203.0.113.7 10.0.0.0/8
	# respond @blocked 403
	reverse_proxy app:8000 {
		# 客户端伪造面封死:清掉入站声明值,由边缘写真实对端 IP。
		# 应用侧 forwardedHeaders 采信 XFF 最右跳(即此处写入的值)。
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
