{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["vite/client"],
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        // Resolve workspace types from source so `pnpm --filter @utopinn/web
        // typecheck` works before @utopinn/protocol has been built.
        "paths": {
            "@utopinn/protocol": ["../../packages/protocol/src/index.ts"],
            "@utopinn/protocol/*": ["../../packages/protocol/src/*"],
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "vite.config.ts"]
}
