{
    "name": "uberge",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">= 24"
    },
    "scripts": {
        "server": "pnpm --filter @uberge/server start",
        "mobile": "pnpm --filter @uberge/mobile start",
        "web": "pnpm --filter @uberge/web dev",
